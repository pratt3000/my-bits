{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Windmill Cove",
  "description": "Mini golf in the Golf With Your Friends mould: six themed courses of nine holes, one screen each, played by pulling back and letting go. Windmills sweep the fairway, sliding gates block the causeway, whirlpools drag your line, cannonball pads fire you down the corridor. Water and out-of-bounds cost a stroke. Sand kills roll, ice barely slows you, ramps push, portals move you. Fernwood, Buccaneer Bay, Sunken Oasis, Hollow Manor, Sugar Rush and Orbital Nine each keep their own fewest-strokes leaderboard.",
  "tags": [
    "golf",
    "game",
    "sports",
    "arcade",
    "physics",
    "leaderboard",
    "minigolf",
    "singleplayer"
  ],
  "permissions": [
    "audio",
    "backgroundMusic",
    "haptics",
    "storage"
  ],
  "dependencies": [],

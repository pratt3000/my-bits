{
  "display": "fullscreen",
  "viewport": {
    "width": 844,
    "height": 390
  },
  "dpr": 1,
  "caps": {
    "motion": true
  },
  "insets": {
    "safeArea": {
      "top": 0,
      "right": 62,
      "bottom": 21,
      "left": 62
    },
    "contentSafeArea": {
      "top": 0,
      "right": 62,
      "bottom": 95,
      "left": 62
    },
    "logoArea": {
      "x": 390,
      "y": 300,
      "width": 64,
      "height": 64
    }
  },
  "steps": [
    {
      "wait": 4000
    },
    {
      "screenshot": "sq-01-title"
    },
    {
      "eval": "document.querySelector('[data-act=\"play\"]').click()"
    },
    {
      "wait": 1600
    },
    {
      "screenshot": "sq-02-first-arm"
    },
    {
      "balance": {
        "ms": 7000,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "screenshot": "sq-03-playing"
    },
    {
      "eval": "document.querySelector('[data-act=\"pause\"]').click()"
    },
    {
      "waitUntil": "window.plethoraBit.debug.state() === 'paused'",
      "timeout": 40000,
      "after": 2200
    },
    {
      "screenshot": "sq-04-pause"
    },
    {
      "expectEvent": "ready"
    },
    {
      "expectEvent": "start"
    }
  ]
}

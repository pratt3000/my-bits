{
  "display": "fullscreen",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "dpr": 1,
  "caps": {
    "motion": true
  },
  "steps": [
    {
      "wait": 3500
    },
    {
      "screenshot": "dbg-00-title"
    },
    {
      "eval": "document.querySelector('[data-act=\"play\"]').click()"
    },
    {
      "wait": 2600
    },
    {
      "log": "window.plethoraBit.debug.snapshot()"
    },
    {
      "balance": {
        "ms": 2500,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "log": "window.plethoraBit.debug.snapshot()"
    },
    {
      "balance": {
        "ms": 2500,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "log": "window.plethoraBit.debug.snapshot()"
    },
    {
      "balance": {
        "ms": 2500,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "log": "window.plethoraBit.debug.snapshot()"
    },
    {
      "screenshot": "dbg-01"
    },
    {
      "balance": {
        "ms": 4000,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "log": "window.plethoraBit.debug.snapshot()"
    },
    {
      "screenshot": "dbg-02"
    }
  ]
}

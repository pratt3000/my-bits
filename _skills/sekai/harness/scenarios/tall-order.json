{
  "display": "fullscreen",
  "viewport": {
    "width": 390,
    "height": 844
  },
  "dpr": 1,
  "caps": {
    "motion": true
  },
  "steps": [
    {
      "wait": 4000
    },
    {
      "screenshot": "01-title"
    },
    {
      "eval": "document.querySelector('[data-act=\"play\"]').click()"
    },
    {
      "wait": 1500
    },
    {
      "screenshot": "02-first-arm"
    },
    {
      "wait": 500
    },
    {
      "screenshot": "02b-hover"
    },
    {
      "wait": 450
    },
    {
      "screenshot": "02c-falling"
    },
    {
      "balance": {
        "ms": 7000,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "screenshot": "03-few-scoops"
    },
    {
      "balance": {
        "ms": 9000,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "screenshot": "04-growing"
    },
    {
      "balance": {
        "ms": 12000,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "screenshot": "05-tall"
    },
    {
      "balance": {
        "ms": 14000,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "screenshot": "06-taller"
    },
    {
      "log": "window.plethoraBit.debug.snapshot()"
    },
    {
      "eval": "window.__tilt = { x: 1, y: 0 }"
    },
    {
      "wait": 900
    },
    {
      "eval": "window.__tilt = { x: -1, y: 0 }"
    },
    {
      "wait": 900
    },
    {
      "eval": "window.__tilt = { x: 1, y: 0.5 }"
    },
    {
      "wait": 1200
    },
    {
      "eval": "window.__tilt = { x: 0, y: 0 }"
    },
    {
      "waitUntil": "window.plethoraBit.debug.state() === 'topple'",
      "timeout": 40000,
      "after": 900
    },
    {
      "screenshot": "07-after-topple"
    },
    {
      "waitUntil": "window.plethoraBit.debug.state() === 'result'",
      "timeout": 40000,
      "after": 2500
    },
    {
      "screenshot": "08-result"
    },
    {
      "eval": "document.querySelector('[data-act=\"again\"]').click()"
    },
    {
      "waitUntil": "window.plethoraBit.debug.state() === 'play'",
      "timeout": 40000,
      "after": 1500
    },
    {
      "screenshot": "09-again"
    },
    {
      "eval": "document.querySelector('[data-act=\"pause\"]').click()"
    },
    {
      "waitUntil": "window.plethoraBit.debug.state() === 'paused'",
      "timeout": 40000,
      "after": 2200
    },
    {
      "screenshot": "10-pause"
    },
    {
      "eval": "document.querySelector('[data-act=\"resume\"]').click()"
    },
    {
      "wait": 300
    },
    {
      "eval": "window.__setInsets({ safeArea: { top: 90, right: 28, bottom: 70, left: 28 }, contentSafeArea: { top: 90, right: 28, bottom: 140, left: 28 }, logoArea: { x: 163, y: 704, width: 64, height: 64 } })"
    },
    {
      "wait": 600
    },
    {
      "screenshot": "11-insets-changed"
    },
    {
      "resize": [
        360,
        780
      ]
    },
    {
      "wait": 400
    },
    {
      "screenshot": "12-resized"
    },
    {
      "expectEvent": "ready"
    },
    {
      "expectEvent": "markVisualReady"
    },
    {
      "expectEvent": "start"
    },
    {
      "expectEvent": "interact"
    },
    {
      "expectEvent": "complete"
    },
    {
      "expectEvent": "record.submit"
    },
    {
      "expectEvent": "leaderboard"
    },
    {
      "expectEvent": "motion.start"
    }
  ]
}

{
  "display": "safe-frame",
  "viewport": {
    "width": 390,
    "height": 778
  },
  "dpr": 1,
  "caps": {
    "motion": true
  },
  "steps": [
    {
      "wait": 4000
    },
    {
      "screenshot": "sf-01-title"
    },
    {
      "eval": "document.querySelector('[data-act=\"play\"]').click()"
    },
    {
      "wait": 1600
    },
    {
      "screenshot": "sf-02-first-arm"
    },
    {
      "balance": {
        "ms": 7000,
        "read": "window.plethoraBit.debug.drive2",
        "mode": "tilt",
        "tick": 50,
        "until": "window.plethoraBit.debug.state() !== 'play'"
      }
    },
    {
      "screenshot": "sf-03-playing"
    },
    {
      "eval": "document.querySelector('[data-act=\"pause\"]').click()"
    },
    {
      "waitUntil": "window.plethoraBit.debug.state() === 'paused'",
      "timeout": 40000,
      "after": 2200
    },
    {
      "screenshot": "sf-04-pause"
    },
    {
      "expectEvent": "ready"
    },
    {
      "expectEvent": "start"
    },
    {
      "expectEvent": "interact"
    }
  ]
}

{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Pen Fight",
  "description": "The Indian school-bench classic, rebuilt in 3D. Flick your pen across a scratched wooden desk and shove your rival's pen off the edge; where you catch the pen decides whether it spins or drives straight. Twelve familiar pens with real weights and grips, a bench of eleven rivals from the back row to the class topper, best-of-five matches scored in chalk on the blackboard, and winner keeps the pen: beat a rival and their pen goes in your tin, lose and yours is gone. Pass-and-play mode for a friend on the same phone.",
  "tags": [
    "3d",
    "physics",
    "game",
    "duel",
    "flick",
    "school",
    "desk",
    "arcade"
  ],
  "permissions": [
    "audio",
    "backgroundMusic",
    "haptics",
    "storage"
  ],
  "dependencies": [
    "three@0.164.1",
    "bebas-neue@1.0.0"
  ],
  "memory": {
    "records": {
      "win_streak": {
        "label": "Round Streak",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "global",
          "following"
        ],
        "dedupe": "best_per_user"
      },
      "tin": {
        "label": "Pens In The Tin",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "global",
          "following"
        ],
        "dedupe": "best_per_user"
      },
      "bench": {
        "label": "Rivals Beaten",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "global",
          "following"
        ],
        "dedupe": "best_per_user"
      }
    }
  }
}

{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Forbidden Five",
  "description": "The word-twisting party game, on one phone. Two teams, and a clue-giver who has to land the word on the card without ever saying it — or any of the five forbidden words printed under it. Say APPLE without RED, FRUIT, PIE, CIDER or CORE. Your team shouts guesses, the other team watches the screen over your shoulder and hits the buzzer the moment you slip. Every word you land is a point, every buzz costs you one, and skips are rationed. Pass the phone, take turns, and play to the whistle. Built for a room: two to four teams, a roster of up to forty names, and a clue-giver rotation that works round every team so nobody hogs the phone. 310 cards across five decks, a turn timer you can set, and a leaderboard for the biggest single turn anyone has ever pulled off.",
  "tags": [
    "party",
    "word-game",
    "guessing",
    "teams",
    "pass-and-play",
    "local-multiplayer",
    "social",
    "family",
    "timer",
    "cards"
  ],
  "permissions": [
    "audio",
    "haptics",
    "storage"
  ],
  "dependencies": [],
  "onboarding": {
    "kind": "briefing",
    "version": 1,
    "replayable": true,
    "pages": [
      {
        "title": "One phone, the whole room",
        "body": "Split the room into two, three or four teams. Each turn, one player on the active team is the clue-giver and holds the phone. Their team shouts guesses. The other teams read the screen over their shoulder and watch for slip-ups."
      },
      {
        "title": "Say the word without saying the word",
        "body": "The big word at the top is what your team has to say out loud. The five words under it are forbidden — so is any part of the answer itself. Land it and tap GOT IT for a point. Stuck? SKIP, if you have skips left."
      },
      {
        "title": "The other team is listening",
        "body": "If the clue-giver says a forbidden word, the watching team taps TABOO and the point comes off. When time runs out the card in hand is dead. Add everyone\u0027s name at setup and the phone will call out whose go it is, working round each team in turn."
      }
    ]
  },

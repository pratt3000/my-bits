{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Chameleon Hunt",
  "description": "You are the Seeker. Hiders are camouflaged into the walls and furniture of five 3D arenas \u2014 spot them, tap them, beat the clock. Wrong accusations cost time. Unlock harder arenas, chase per-arena leaderboards, and listen for giggles when you get close.",
  "tags": [
    "3d",
    "hide-and-seek",
    "camouflage",
    "seeker",
    "arcade",
    "mobile"
  ],
  "permissions": [
    "haptics",
    "backgroundMusic",
    "audio",
    "storage"
  ],
  "dependencies": [
    "three@0.164.1"
  ],

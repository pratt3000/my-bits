{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Backseat Rain",
  "description": "The back seat window on a wet drive home. Beads gather on the glass, slant in the wind, and the moment one gets heavy enough it breaks loose and runs — swallowing every drop in its path. Three drops get rings: back one, drag the glass to feed it, and watch it race the others down to the sill.",
  "tags": [
    "rain",
    "relaxing",
    "asmr",
    "satisfying",
    "sensory",
    "ambient",
    "water",
    "racing",
    "cozy",
    "fidget"
  ],
  "permissions": [
    "audio",
    "backgroundMusic",
    "haptics",
    "motion",
    "storage"
  ],
  "dependencies": [],
  "memory": {
    "local": {
      "window_stats": {
        "label": "Your window"
      }
    },
    "records": {
      "streak": {
        "label": "Best Streak",
        "valueType": "streak",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "following",
          "global"
        ],
        "dedupe": "best_per_user"
      },
      "wins": {
        "label": "Races Won",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "following",
          "global"
        ],
        "dedupe": "best_per_user"
      }
    }
  }
}

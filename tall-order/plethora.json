{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Tall Order",
  "description": "Balance the tallest ice cream tower in town, in 3D, with the phone. A scooper holds the cone in a little parlour, two machine arms swing in from the left and right and pile on scoop after scoop, and you tilt the phone to walk the cone under the lean — sideways and toward or away from you — before the centre of mass gets away. Big scoops land heavy, minis come in threes, and every few scoops the machine shouts INCOMING and fires a burst for double points. Spill three and the customer walks; let it topple and it is over. Clean, steady landings build a multiplier. Drag works where there are no motion sensors. Leaderboards for best score and tallest tower.",
  "tags": [
    "3d",
    "game",
    "arcade",
    "balance",
    "ice-cream",
    "tilt",
    "motion",
    "stacking",
    "leaderboard",
    "physics"
  ],
  "permissions": [
    "audio",
    "backgroundMusic",
    "haptics",
    "motion",
    "storage"
  ],
  "dependencies": [
    "three@0.164.1"
  ],
  "display": "fullscreen",
  "memory": {
    "records": {
      "score": {
        "label": "Best Score",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "global",
          "following"
        ],
        "dedupe": "best_per_user"
      },
      "tower": {
        "label": "Tallest Tower",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "global",
          "following"
        ],
        "dedupe": "best_per_user"
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "difficulty": {
        "label": "Difficulty"
      },
      "gameplay": {
        "label": "Scoops"
      },
      "feel": {
        "label": "Feel"
      },
      "audio": {
        "label": "Sound"
      }
    },
    "knobs": {
      "topple_speed": {
        "label": "How fast the tower falls over",
        "type": "number",
        "default": 1,
        "min": 0.5,
        "max": 1.6,
        "step": 0.05,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "live"
      },
      "stickiness": {
        "label": "Ice cream stickiness",
        "type": "percent",
        "default": 0.35,
        "min": 0,
        "max": 0.8,
        "step": 0.05,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "live"
      },
      "placement_error": {
        "label": "How far off-centre the arms drop",
        "type": "percent",
        "default": 0.3,
        "min": 0,
        "max": 1,
        "step": 0.05,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "live"
      },
      "drop_interval_ms": {
        "label": "Time between scoops",
        "type": "duration_ms",
        "default": 2000,
        "min": 900,
        "max": 3500,
        "step": 100,
        "group": "difficulty",
        "intent": "difficulty",
        "apply": "live"
      },
      "rush_every": {
        "label": "Scoops between INCOMING rushes",
        "type": "integer",
        "default": 8,
        "min": 4,
        "max": 20,
        "step": 1,
        "group": "gameplay",
        "intent": "gameplay",
        "apply": "live"
      },
      "big_scoop_chance": {
        "label": "Big scoop chance",
        "type": "percent",
        "default": 0.15,
        "min": 0,
        "max": 0.6,
        "step": 0.05,
        "group": "gameplay",
        "intent": "gameplay",
        "apply": "live"
      },
      "mini_scoop_chance": {
        "label": "Mini triplet chance",
        "type": "percent",
        "default": 0.12,
        "min": 0,
        "max": 0.6,
        "step": 0.05,
        "group": "gameplay",
        "intent": "gameplay",
        "apply": "live"
      },
      "control_sensitivity": {
        "label": "Tilt and drag sensitivity",
        "type": "number",
        "default": 1,
        "min": 0.5,
        "max": 2,
        "step": 0.1,
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "tilt_forward": {
        "label": "Tilting the phone's top away walks the cone",
        "type": "choice",
        "default": "away",
        "options": [
          "away",
          "toward"
        ],
        "group": "feel",
        "intent": "feel",
        "apply": "live"
      },
      "music_intensity": {
        "label": "Music intensity",
        "type": "percent",
        "default": 0.5,
        "min": 0,
        "max": 1,
        "step": 0.05,
        "group": "audio",
        "intent": "audio",
        "apply": "live"
      }
    },
    "curves": {
      "difficulty_ramp": {
        "label": "Pace and placement error by tower height (scoops)",
        "domain": "custom",
        "range": [
          0.6,
          2.4
        ],
        "default": [
          {
            "x": 0,
            "y": 0.85
          },
          {
            "x": 10,
            "y": 1.1
          },
          {
            "x": 25,
            "y": 1.6
          },
          {
            "x": 50,
            "y": 2.4
          }
        ],
        "easing": "smooth",
        "group": "difficulty",
        "apply": "live"
      }
    },
    "presets": {
      "chill": {
        "label": "Chill",
        "values": {
          "topple_speed": 0.7,
          "placement_error": 0.15,
          "drop_interval_ms": 2600,
          "rush_every": 12
        }
      },
      "frantic": {
        "label": "Frantic",
        "values": {
          "topple_speed": 1.3,
          "placement_error": 0.5,
          "drop_interval_ms": 1300,
          "rush_every": 6,
          "big_scoop_chance": 0.25
        }
      }
    }
  },
  "onboarding": {
    "kind": "immersive",
    "version": 1
  }
}

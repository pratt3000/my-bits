{
  "schemaVersion": 1,
  "runtime": "plethora-bit@2",
  "entry": "main.js",
  "title": "Petri Bloom",
  "description": "You are one glowing cell in a dish full of hungry ones. Drag to steer, swallow anything smaller than you, and evolve through eight stages of life \u2014 from spore to apex bloom \u2014 while staying clear of anything bigger, because the heavier you get the slower you swim. Golden blooms are a dozen meals in one; chain kills for a frenzy bonus. Split to lunge at prey and you are briefly several fragile halves instead of one safe whole. Spit mass into a spiked virus and it fires a new one across the dish; blunder into one yourself and you burst into pieces, which is the only thing keeping the leader honest. Single player against twenty-eight bots that flee, hunt, ambush and hide.",
  "tags": [
    "arcade",
    "action",
    "io-game",
    "eat",
    "grow",
    "bots",
    "arena",
    "one-hand",
    "leaderboard",
    "survival"
  ],
  "permissions": [
    "audio",
    "haptics",
    "storage"
  ],
  "dependencies": [],
  "onboarding": {
    "kind": "guided",
    "version": 1,
    "replayable": true,
    "steps": [
      {
        "id": "steer",
        "title": "Drag to steer",
        "body": "Put a finger anywhere on the dish and your cell swims towards it. The heavier you get, the slower you move \u2014 that trade is the whole game.",
        "advance": "continue"
      },
      {
        "id": "eat",
        "title": "Swallow anything smaller",
        "body": "The glowing specks are free mass, and the golden blooms are worth a dozen of them. So is any cell meaningfully smaller than yours \u2014 cover it and it is yours. Every few hundred mass you evolve into something bigger; the bar under your mass shows how close the next stage is.",
        "advance": "continue"
      },
      {
        "id": "split",
        "title": "Split to catch, not to sit",
        "body": "SPLIT throws half of you forward at speed. It is how you catch something quicker than you, and it leaves you as fragile halves until the merge timer runs down. FEED spits out a blob of your own mass.",
        "advance": "continue"
      },
      {
        "id": "virus",
        "title": "Mind the spikes",
        "body": "Green spiked viruses burst anything bigger than they are into a dozen pieces. Small cells can hide inside them. Seven fed blobs makes one fire a new virus across the dish \u2014 which is how you break someone who has got too big.",
        "advance": "continue"
      }
    ]
  },
  "memory": {
    "records": {
      "best_mass": {
        "label": "Biggest Bloom",
        "valueType": "number",
        "order": "desc",
        "format": "integer",
        "periods": [
          "daily",
          "weekly",
          "all_time"
        ],
        "scopes": [
          "following",
          "global"
        ],
        "dedupe": "best_per_user"
      }
    }
  },
  "tuning": {
    "schemaVersion": 1,
    "groups": {
      "dish": {
        "label": "The Dish"
      },
      "feel": {
        "label": "Feel"
      },
      "look": {
        "label": "Look"
      }
    },
    "knobs": {
      "bot_count": {
        "label": "Rival cells in the dish",
        "type": "integer",
        "default": 28,
        "min": 8,
        "max": 60,
        "step": 1,
        "group": "dish",
        "intent": "difficulty",
        "apply": "restart"
      },
      "world_size": {
        "label": "Dish width",
        "type": "integer",
        "default": 3600,
        "min": 2400,
        "max": 7000,
        "step": 100,
        "group": "dish",
        "intent": "gameplay",
        "apply": "restart"
      },
      "pellet_count": {
